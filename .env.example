# Zotero Configuration
ZOTERO_ID=your_zotero_id
ZOTERO_KEY=your_zotero_api_key

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1
MODEL=gpt-4o-mini

# Email Configuration (legacy QQ SMTP)
SENDER=your_email@example.com
RECEIVER=receiver_email@example.com
SENDER_PASSWORD=your_email_smtp_password

# Resend email (bilingual daily, sends zh/en separately)
RESEND_ENABLED=true
RESEND_API_KEY=re_xxxxx
RESEND_SENDER_NAME=arXiv Daily
RESEND_SENDER_EMAIL=daily@nickelates.uk
RECIPIENTS_ZH=user1@example.com,user2@example.com
RECIPIENTS_EN=user3@example.com,user4@example.com

# Hugo Configuration
HUGO_OUTPUT_DIR=./hugo_output
HUGO_AUTO_PUSH=false

# System Configuration
DEBUG=false
